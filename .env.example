# ResourceSpace Canva Platform Broker — example environment
# Copy to `.env` and fill in for local development. Never commit a populated
# .env. See README.md "Deployment" for the full list of values your hosting
# provider must set in production.

# defaults to production when unset. Set development for local runs.
APP_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
OAUTH_ISSUER=http://localhost:3001

# OAuth client identity. In development the broker accepts the placeholder
# below; the production validator refuses to start unless this is set to a
# non-default client id and OAUTH_REDIRECT_URI_ALLOWLIST is filled in.
#
# If your Canva Developer Portal app is configured with the placeholder
# `canva-dev-app` as the client id and you don't want to change it, set
# OAUTH_ALLOW_DEFAULT_CLIENT_ID=true to opt in. Only safe when the redirect
# URI allowlist is tightly scoped to Canva-controlled URLs — otherwise an
# attacker who guesses the placeholder can drive an OAuth flow.
OAUTH_CLIENT_ID=canva-dev-app
OAUTH_ALLOW_DEFAULT_CLIENT_ID=
OAUTH_REDIRECT_URI_ALLOWLIST=

# Optional future-integration registry. Leave unset for the current Canva-only
# deployment. When set, each entry adds or overrides an accepted OAuth client
# with its own integration label and redirect allowlist. Keep redirect URIs
# client-specific; do not use one integration's callback URL for another.
# OAUTH_CLIENTS_JSON=[{"clientId":"partner-client","integration":"partner-integration","redirectUriAllowlist":["https://partner.example/callback"]}]
OAUTH_CLIENTS_JSON=
OAUTH_REFRESH_GRACE_SECONDS=30

# Refresh-token lifetime, in seconds. UAT default below is 604800 (7 days).
# Production may raise it (the code fallback when unset is 2592000 / 30 days).
REFRESH_TOKEN_TTL_SECONDS=604800

TOKEN_TTL_SECONDS=900
SIGNED_URL_TTL_SECONDS=300
AUTH_CODE_TTL_SECONDS=300

# Long random value (32+ bytes) — required in production. Default below is
# insecure and the validator rejects it outside development.
ASSET_SIGNING_SECRET=replace-me

# Set to the origin(s) Canva uses to talk to the broker, comma-separated.
# Typically the iframe origin (https://app-<lowercased-app-id>.canva-apps.com)
# AND the editor origin (https://www.canva.com) — the editor fetches image
# bytes when the user drags an asset onto the canvas. Wildcard is rejected
# outside development.
CORS_ORIGIN=*

STORAGE_PATH=.data/platform-store.json

# Fernet key for encrypting sensitive store fields (session keys, email) at
# rest. Required outside development/test. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# Client IP header for rate limiting and SSO quotas. Default outside
# development/test is x-real-ip, but only honoured when the transport peer
# matches TRUSTED_PROXY_HOSTS (see below).
CLIENT_IP_HEADER=

# Comma-separated CIDRs/addresses of reverse proxies permitted to supply
# CLIENT_IP_HEADER. Defaults to RFC1918+loopback+100.64.0.0/10 outside
# development/test (Railway internal networking commonly uses CGNAT). The
# uvicorn entrypoint keeps proxy_headers=false so this layer owns resolution.

# Optional HMAC key for transportPeerHash / resolvedClientHostHash log fields.
# Defaults to ASSET_SIGNING_SECRET when unset.
CLIENT_IP_LOG_KEY=

# When true, SSO client-identity logs also include raw transportPeer for
# TRUSTED_PROXY_HOSTS tuning. Permitted only when APP_ENV is development,
# test, staging, or uat.
CLIENT_IP_LOG_DIAGNOSTICS=
# Set empty only together with CLIENT_IP_HEADER= when directly exposed.
TRUSTED_PROXY_HOSTS=

# Background prune interval for expired store records, in seconds. Default
# 3600. Set to 0 to disable (lazy prune on next store transaction only).
STORE_PRUNE_INTERVAL_SECONDS=3600

# Canva-issued OAuth client secret. Required in production. The broker
# refuses to start without it whenever APP_ENV is anything other than
# development/test. Used to verify the signature on the
# /webhooks/canva/user-uninstall request (Canva → broker, server-to-server).
CANVA_CLIENT_SECRET=

# Signature verification mode for the user-uninstall webhook:
#   off       — skip verification (development only)
#   smart     — verify only when Canva supplies signature material (development only)
#   required  — always verify; reject unsigned webhooks (production)
# Production deploys must use `required`.
# This setting does NOT apply to /content/* endpoints — those are
# browser-direct fetches that Canva cannot sign, and are protected by
# OAuth bearer tokens + scope enforcement instead.
CANVA_REQUEST_VERIFICATION_MODE=smart
CANVA_REQUEST_TIMESTAMP_TOLERANCE_SECONDS=300

# Upload (Canva → ResourceSpace) protections.
# CANVA_UPLOAD_ALLOWED_HOSTS is a comma-separated exact-match host allowlist
# for the `source_url` Canva sends. Empty means "any public host" (private
# IPs are still blocked). Capture real hosts from the first prod deploy.
CANVA_UPLOAD_ALLOWED_HOSTS=
CANVA_UPLOAD_MAX_BYTES=52428800
CANVA_UPLOAD_MAX_IMAGE_PIXELS=50000000

RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

RESOURCE_SPACE_MODE=fixture
# Approved canonical ResourceSpace hostname suffixes. A leading dot matches
# subdomains only; `.resourcespace.com` accepts both
# `tenant.resourcespace.com` and `spotdev.free.resourcespace.com`, but not
# lookalike domains. Customers should use their original ResourceSpace-provided
# hostname even if they normally use a custom domain. Dynamic tenants must use
# HTTPS on port 443 and resolve only to public addresses.
RESOURCE_SPACE_ALLOWED_HOSTS=.resourcespace.com
# Optional exact tenant records. Use these only when a customer's original
# ResourceSpace hostname is unavailable, or when an instance needs an explicit
# API URL or other per-tenant configuration.
RESOURCE_SPACE_TENANTS_JSON=[{"id":"acme-uat","slug":"acme-uat","name":"Acme UAT","baseUrl":"https://acme.demo.resourcespace.local","rootCollections":["12"],"collectionChildren":{"12":["33"]}}]

# ResourceSpace hosted-login (SSO) handoff. Off by default: the sign-in page
# shows only the password form and POST /oauth/sso/callback returns 404. See
# docs/SSO-SETUP-STEPS.md for the tenant-side (SAML/Entra) setup this depends
# on.
RESOURCE_SPACE_SSO_ENABLED=false
# The ResourceSpace "system" destination key used in the outbound handoff URL
# (pages/user/user_api_session.php?system=<this>). Must match the destination
# the ResourceSpace tenant has registered for this integration.
RESOURCE_SPACE_SSO_SYSTEM_KEY=canva
# How long a pending SSO handoff state stays valid, in seconds. Generous
# enough to allow time for SAML/MFA at the tenant.
RESOURCE_SPACE_SSO_PENDING_TTL_SECONDS=600
# How long a used or expired handoff-state tombstone is kept after expiry, so
# POST /oauth/sso/callback can tell a replay or an expiry apart from an
# unknown state in its logs.
RESOURCE_SPACE_SSO_REPLAY_RETENTION_SECONDS=600

# Optional egress allowlist for the signed-asset proxy fetch (preview/download
# grants). Comma-separated. A bare entry (cdn.example.com) matches that exact
# host only; prefix with a dot (.example.com) to also match subdomains. Empty
# means any public host is allowed (private IPs are still blocked
# unconditionally).
RESOURCE_SPACE_ASSET_ALLOWED_HOSTS=
# Hard cap, in bytes, on a single proxied asset response. The fetch streams
# the response and aborts once this is exceeded. Default 52428800 (50 MiB).
RESOURCE_SPACE_ASSET_PROXY_MAX_BYTES=52428800

# Optional. When set, /metrics returns the extended posture payload only
# to callers that present `Authorization: Bearer <this token>`. Empty means
# the public /metrics returns aggregate counts only (no posture data).
METRICS_TOKEN=

# Production notes:
# - switch RESOURCE_SPACE_MODE to live
# - configure at least one approved tenant routing source: canonical suffixes in
#   RESOURCE_SPACE_ALLOWED_HOSTS and/or exact entries in RESOURCE_SPACE_TENANTS_JSON
# - replace BASE_URL and OAUTH_ISSUER with the public HTTPS broker URL
# - replace STORAGE_PATH with a persistent disk-backed path
#   (e.g. /var/lib/resourcespace-platform/platform-store.json)
# - generate ASSET_SIGNING_SECRET via `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# - generate STORAGE_ENCRYPTION_KEY via `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# - populate CANVA_CLIENT_SECRET from your Canva app's OAuth credentials
# - set OAUTH_REDIRECT_URI_ALLOWLIST to the redirect_uri(s) your Canva
#   integration is configured to use, comma-separated
# - keep reviewer credentials and tenant-specific notes out of source control
