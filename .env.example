# ResourceSpace Canva Platform Broker — example environment
# Copy to `.env` and fill in for local development. Never commit a populated
# .env. See README.md "Deployment" for the full list of values your hosting
# provider must set in production.

APP_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
OAUTH_ISSUER=http://localhost:3001

# OAuth client identity. In development the broker accepts the placeholder
# below; the production validator refuses to start unless this is set to a
# non-default client id and OAUTH_REDIRECT_URI_ALLOWLIST is filled in.
#
# If your Canva Developer Portal app is configured with the placeholder
# `canva-dev-app` as the client id and you don't want to change it, set
# OAUTH_ALLOW_DEFAULT_CLIENT_ID=true to opt in. Only safe when the redirect
# URI allowlist is tightly scoped to Canva-controlled URLs — otherwise an
# attacker who guesses the placeholder can drive an OAuth flow.
OAUTH_CLIENT_ID=canva-dev-app
OAUTH_ALLOW_DEFAULT_CLIENT_ID=
OAUTH_REDIRECT_URI_ALLOWLIST=

# Optional future-integration registry. Leave unset for the current Canva-only
# deployment. When set, each entry adds or overrides an accepted OAuth client
# with its own integration label and redirect allowlist. Keep redirect URIs
# client-specific; do not use one integration's callback URL for another.
# OAUTH_CLIENTS_JSON=[{"clientId":"tagquest-client","integration":"tagquest","redirectUriAllowlist":["https://tagquest.example/callback"]}]
OAUTH_CLIENTS_JSON=
OAUTH_REFRESH_GRACE_SECONDS=30

TOKEN_TTL_SECONDS=900
SIGNED_URL_TTL_SECONDS=300
AUTH_CODE_TTL_SECONDS=300

# Long random value (32+ bytes) — required in production. Default below is
# insecure and the validator rejects it outside development.
ASSET_SIGNING_SECRET=replace-me

# Set to the origin(s) Canva uses to talk to the broker, comma-separated.
# Typically the iframe origin (https://app-<lowercased-app-id>.canva-apps.com)
# AND the editor origin (https://www.canva.com) — the editor fetches image
# bytes when the user drags an asset onto the canvas. Wildcard is rejected
# outside development.
CORS_ORIGIN=*

STORAGE_PATH=.data/platform-store.json

# Canva-issued OAuth client secret. Required in production. The broker
# refuses to start without it whenever APP_ENV is anything other than
# development/test. Used to verify the signature on the
# /webhooks/canva/user-uninstall request (Canva → broker, server-to-server).
CANVA_CLIENT_SECRET=

# Signature verification mode for the user-uninstall webhook:
#   off       — skip verification (development only)
#   smart     — verify only when Canva supplies signature material (development only)
#   required  — always verify; reject unsigned webhooks (production)
# Production deploys must use `required`.
# This setting does NOT apply to /content/* endpoints — those are
# browser-direct fetches that Canva cannot sign, and are protected by
# OAuth bearer tokens + scope enforcement instead.
CANVA_REQUEST_VERIFICATION_MODE=smart
CANVA_REQUEST_TIMESTAMP_TOLERANCE_SECONDS=300

# Upload (Canva → ResourceSpace) protections.
# CANVA_UPLOAD_ALLOWED_HOSTS is a comma-separated exact-match host allowlist
# for the `source_url` Canva sends. Empty means "any public host" (private
# IPs are still blocked). Capture real hosts from the first prod deploy.
CANVA_UPLOAD_ALLOWED_HOSTS=
CANVA_UPLOAD_MAX_BYTES=52428800
CANVA_UPLOAD_MAX_IMAGE_PIXELS=50000000

RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

RESOURCE_SPACE_MODE=fixture
RESOURCE_SPACE_ALLOWED_HOSTS=.resourcespace.example.com
RESOURCE_SPACE_TENANTS_JSON=[{"id":"acme-uat","slug":"acme-uat","name":"Acme UAT","baseUrl":"https://acme.demo.resourcespace.local","rootCollections":["12"],"collectionChildren":{"12":["33"]}}]

# Optional. When set, /metrics returns the extended posture payload only
# to callers that present `Authorization: Bearer <this token>`. Empty means
# the public /metrics returns aggregate counts only (no posture data).
METRICS_TOKEN=

# Production notes:
# - switch RESOURCE_SPACE_MODE to live
# - replace BASE_URL and OAUTH_ISSUER with the public HTTPS broker URL
# - replace STORAGE_PATH with a persistent disk-backed path
#   (e.g. /var/lib/resourcespace-platform/platform-store.json)
# - generate ASSET_SIGNING_SECRET via `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# - populate CANVA_CLIENT_SECRET from your Canva app's OAuth credentials
# - set OAUTH_REDIRECT_URI_ALLOWLIST to the redirect_uri(s) your Canva
#   integration is configured to use, comma-separated
# - keep reviewer credentials and tenant-specific notes out of source control
